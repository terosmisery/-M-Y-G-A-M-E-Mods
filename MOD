local Players = game:GetService("Players")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

--==================================================
-- DIALOGUE SETUP
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local dialogueLabel =
	baseFrame.Layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		.Layer2Group
		.BaseGroup
		.GameFrame
		.DialogueFrame

local requestSpeech =
	dialogueFrame:WaitForChild("RequestSpeech")

local characterVoice =
	mainUI:FindFirstChild("Character_Voice", true)

if not dialogueLabel then
	warn("DialogueLabel not found")
	return
end

if not characterVoice or not characterVoice:IsA("Sound") then
	warn("Character_Voice not found")
	return
end

--==================================================
-- DISABLE GUI INTERACTION
--==================================================

local lockedButtons = {}
local lockedTextBoxes = {}

local function lockInteraction()
	for _, obj in ipairs(pg:GetDescendants()) do
		if obj:IsA("GuiButton") then
			lockedButtons[obj] = {
				Active = obj.Active,
				Selectable = obj.Selectable
			}

			obj.Active = false
			obj.Selectable = false

		elseif obj:IsA("TextBox") then
			lockedTextBoxes[obj] = {
				Active = obj.Active,
				TextEditable = obj.TextEditable
			}

			obj.Active = false
			obj.TextEditable = false
		end
	end
end

local function unlockInteraction()
	for obj, state in pairs(lockedButtons) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.Selectable = state.Selectable
		end
	end

	for obj, state in pairs(lockedTextBoxes) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.TextEditable = state.TextEditable
		end
	end

	table.clear(lockedButtons)
	table.clear(lockedTextBoxes)
end

lockInteraction()

--==================================================
-- STOP ALL AUDIO FIRST
--==================================================

if amb.IsPlaying then
	amb:Stop()
end

if level1.IsPlaying then
	level1:Stop()
end

if level2.IsPlaying then
	level2:Stop()
end

amb.Volume = 0
level1.Volume = 0
level2.Volume = 0

--==================================================
-- SPEECH FUNCTION
--==================================================

local function say(text, duration)
	text = tostring(text)
	duration = duration or 3

	dialogueLabel.AutoLocalize = false
	dialogueLabel.Text = text

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = true
	end

	pcall(function()
		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},
			true,
			duration,
			characterVoice
		)
	end)

	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	dialogueLabel.Text = ""

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = false
	end
end

--==================================================
-- SCRIPT NARRATION
--==================================================

say("Injecting the script.", 2)

say("Initializing.", 1.5)

say("Ambient audio is disabled.", 2)

say("Starting Level 1 audio.", 2)

level1.Volume = 1
level1.Looped = true
level1:Play()

say("Level 1 audio is now playing.", 2)

say("Level 2 audio is disabled.", 2)

level2.Volume = 0
level2:Stop()

say("Setting up the interface.", 2)

say("Initialization complete.", 2)

--==================================================
-- RESTORE GUI INTERACTION
--==================================================

unlockInteraction()
