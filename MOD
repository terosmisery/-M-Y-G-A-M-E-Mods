--==================================================
-- SAVE EFFECT STATES
--==================================================

local savedEffects = {}

local function saveGuiObject(obj)
	if not obj:IsA("GuiObject") then
		return
	end

	local state = {
		Visible = obj.Visible,
		BackgroundTransparency = obj.BackgroundTransparency
	}

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		state.ImageTransparency = obj.ImageTransparency
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		state.TextTransparency = obj.TextTransparency
	end

	savedEffects[obj] = state
end

saveGuiObject(secretLabel)
saveGuiObject(vignetteLabel)
saveGuiObject(staticLabel)

for _, obj in ipairs(staticLabel:GetDescendants()) do
	saveGuiObject(obj)
end

--==================================================
-- SHOW EFFECTS
--==================================================

local function setEffectTransparency(obj, value)

	if obj:IsA("GuiObject") then
		obj.BackgroundTransparency = value
	end

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		obj.ImageTransparency = value
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		obj.TextTransparency = value
	end
end

local function makeEffectsVisible()

	for obj in pairs(savedEffects) do
		if obj and obj.Parent then
			obj.Visible = true
			setEffectTransparency(obj, 1)
		end
	end
end

local function fadeEffectsIn()

	for obj in pairs(savedEffects) do

		if obj and obj.Parent then

			obj.Visible = true

			local properties = {}

			if obj:IsA("GuiObject") then
				properties.BackgroundTransparency = 0
			end

			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				properties.ImageTransparency = 0
			end

			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				properties.TextTransparency = 0
			end

			TweenService:Create(
				obj,
				TweenInfo.new(
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				properties
			):Play()
		end
	end
end

local function fadeEffectsOut()

	local tweens = {}

	for obj in pairs(savedEffects) do

		if obj and obj.Parent then

			local properties = {}

			if obj:IsA("GuiObject") then
				properties.BackgroundTransparency = 1
			end

			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				properties.ImageTransparency = 1
			end

			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				properties.TextTransparency = 1
			end

			local tween = TweenService:Create(
				obj,
				TweenInfo.new(
					1,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.In
				),
				properties
			)

			table.insert(tweens, tween)
			tween:Play()
		end
	end

	task.wait(1)
end

--==================================================
-- BASE FRAME ZOOM
--==================================================

local originalSize = baseFrame.Size
local originalPosition = baseFrame.Position

local zoomSize = UDim2.new(
	originalSize.X.Scale * 1.035,
	originalSize.X.Offset * 1.035,
	originalSize.Y.Scale * 1.035,
	originalSize.Y.Offset * 1.035
)

local zoomPosition = UDim2.new(
	originalPosition.X.Scale - (zoomSize.X.Scale - originalSize.X.Scale) / 2,
	originalPosition.X.Offset - (zoomSize.X.Offset - originalSize.X.Offset) / 2,
	originalPosition.Y.Scale - (zoomSize.Y.Scale - originalSize.Y.Scale) / 2,
	originalPosition.Y.Offset - (zoomSize.Y.Offset - originalSize.Y.Offset) / 2
)

