say("Initializing.", 1.5)

say("Disabling the ambient soundtrack.", 2)

say("Starting Level 1 audio.", 2)

say("Disabling Level 2 audio.", 2)

say("Setting up the interface.", 2)

say("Loading the script.", 2)

say("Everything is ready.", 3)
