--==================================================
-- SAVE ORIGINAL STATES
--==================================================

local originalStates = {}

local function saveObject(obj)

	if not obj:IsA("GuiObject") then
		return
	end

	local state = {
		Visible = obj.Visible,
		BackgroundTransparency = obj.BackgroundTransparency
	}

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		state.ImageTransparency = obj.ImageTransparency
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		state.TextTransparency = obj.TextTransparency
	end

	originalStates[obj] = state
end

-- SecretLabel
saveObject(secretLabel)

-- VignetteLabel
saveObject(vignetteLabel)

-- Vignette children
for _, obj in ipairs(vignetteLabel:GetDescendants()) do
	saveObject(obj)
end

-- StaticLabel
saveObject(staticLabel)

-- StaticLabel children
for _, obj in ipairs(staticLabel:GetDescendants()) do
	saveObject(obj)
end

--==================================================
-- VIGNETTE BACKGROUND FIX
--==================================================

-- This MUST remain transparent.
vignetteLabel.BackgroundTransparency = 1

--==================================================
-- EFFECT PROPERTY HELPERS
--==================================================

local function setVisualTransparency(obj, value)

	if not obj or not obj.Parent then
		return
	end

	-- Vignette background is NEVER changed.
	if obj ~= vignetteLabel then
		obj.BackgroundTransparency = value
	end

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		obj.ImageTransparency = value
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		obj.TextTransparency = value
	end
end

--==================================================
-- PREPARE EFFECTS
--==================================================

local function prepareEffects()

	-- SecretLabel
	secretLabel.Visible = true

	if secretLabel:IsA("TextLabel") or secretLabel:IsA("TextButton") then
		secretLabel.TextTransparency = 1
	end

	if secretLabel:IsA("ImageLabel") or secretLabel:IsA("ImageButton") then
		secretLabel.ImageTransparency = 1
	end

	-- Vignette
	vignetteLabel.Visible = true
	vignetteLabel.BackgroundTransparency = 1

	if vignetteLabel:IsA("ImageLabel") or vignetteLabel:IsA("ImageButton") then
		vignetteLabel.ImageTransparency = 1
	end

	if vignetteLabel:IsA("TextLabel") or vignetteLabel:IsA("TextButton") then
		vignetteLabel.TextTransparency = 1
	end

	-- Vignette descendants
	for _, obj in ipairs(vignetteLabel:GetDescendants()) do

		if obj:IsA("GuiObject") then
			obj.Visible = true
		end

		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.ImageTransparency = 1
		end

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			obj.TextTransparency = 1
		end
	end

	-- Static + children
	for obj in pairs(originalStates) do

		if obj ~= vignetteLabel
			and obj ~= secretLabel
			and obj.Parent
		then

			obj.Visible = true

			if obj:IsA("GuiObject") then
				obj.BackgroundTransparency = 1
			end

			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				obj.ImageTransparency = 1
			end

			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				obj.TextTransparency = 1
			end
		end
	end
end

--==================================================
-- FADE EFFECTS IN
--==================================================

local function fadeEffectsIn()

	for obj in pairs(originalStates) do

		if not obj or not obj.Parent then
			continue
		end

		obj.Visible = true

		local properties = {}

		-- Vignette background ALWAYS stays 1.
		if obj ~= vignetteLabel then
			properties.BackgroundTransparency = 0
		end

		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			properties.ImageTransparency = 0
		end

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			properties.TextTransparency = 0
		end

		if next(properties) then

			TweenService:Create(
				obj,
				TweenInfo.new(
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				properties
			):Play()

		end
	end

	-- Explicitly keep vignette background transparent.
	vignetteLabel.BackgroundTransparency = 1
end

--==================================================
-- FADE EFFECTS OUT
--==================================================

local function fadeEffectsOut()

	for obj, original in pairs(originalStates) do

		if not obj or not obj.Parent then
			continue
		end

		local properties = {}

		-- Vignette background NEVER gets changed.
		if obj ~= vignetteLabel then
			properties.BackgroundTransparency =
				original.BackgroundTransparency
		end

		if original.ImageTransparency ~= nil then
			properties.ImageTransparency =
				original.ImageTransparency
		end

		if original.TextTransparency ~= nil then
			properties.TextTransparency =
				original.TextTransparency
		end

		if next(properties) then

			TweenService:Create(
				obj,
				TweenInfo.new(
					1,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.In
				),
				properties
			):Play()

		end
	end

	-- Keep the vignette background transparent while fading.
	vignetteLabel.BackgroundTransparency = 1

	task.wait(1)

	vignetteLabel.BackgroundTransparency = 1
end

--==================================================
-- ZOOM
--==================================================

local zoomScale =
	baseFrame:FindFirstChild("C9HZZEnjoyScale")

local createdScale = false

if not zoomScale then

	zoomScale = Instance.new("UIScale")
	zoomScale.Name = "C9HZZEnjoyScale"
	zoomScale.Scale = 1
	zoomScale.Parent = baseFrame

	createdScale = true
end

local originalScale = zoomScale.Scale

--==================================================
-- ENJOY
--==================================================

prepareEffects()

dialogueLabel.AutoLocalize = false
dialogueLabel.Text = "Enjoy."
dialogueLabel.Parent.Visible = true

-- Fade SecretLabel / Vignette / Static in.
fadeEffectsIn()

-- Slight zoom in.
local zoomIn = TweenService:Create(
	zoomScale,
	TweenInfo.new(
		1.2,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out
	),
	{
		Scale = originalScale * 1.05
	}
)

zoomIn:Play()

-- Keep everything active for 5 seconds.
task.wait(5)

-- Fade effects back out.
fadeEffectsOut()

-- Zoom back to original.
local zoomOut = TweenService:Create(
	zoomScale,
	TweenInfo.new(
		1.2,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut
	),
	{
		Scale = originalScale
	}
)

zoomOut:Play()
zoomOut.Completed:Wait()

--==================================================
-- RESTORE ORIGINAL STATES
--==================================================

for obj, state in pairs(originalStates) do

	if obj and obj.Parent then

		obj.Visible = state.Visible

		-- Vignette background is explicitly restored to 1.
		if obj == vignetteLabel then
			obj.BackgroundTransparency = 1
		else
			obj.BackgroundTransparency =
				state.BackgroundTransparency
		end

		if state.ImageTransparency ~= nil then
			obj.ImageTransparency =
				state.ImageTransparency
		end

		if state.TextTransparency ~= nil then
			obj.TextTransparency =
				state.TextTransparency
		end
	end
end

dialogueLabel.Text = ""
dialogueLabel.Parent.Visible = false

--==================================================
-- REMOVE TEMPORARY SCALE
--==================================================

if createdScale and zoomScale then
	zoomScale:Destroy()
else
	zoomScale.Scale = originalScale
end

--==================================================
-- UNLOCK
--==================================================

interactionLocked = false

if guiLockConnection then
	guiLockConnection:Disconnect()
end

ContextActionService:UnbindAction(INPUT_LOCK_NAME)

restoreGui()
