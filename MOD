local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

--==================================================
-- DIALOGUE SETUP
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local dialogueLabel =
	baseFrame.Layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		.Layer2Group
		.BaseGroup
		.GameFrame
		.DialogueFrame

local requestSpeech =
	dialogueFrame:WaitForChild("RequestSpeech")

local characterVoice =
	mainUI:FindFirstChild("Character_Voice", true)

if not dialogueLabel then
	warn("DialogueLabel not found")
	return
end

if not characterVoice or not characterVoice:IsA("Sound") then
	warn("Character_Voice not found")
	return
end

--==================================================
-- BLOCK MOUSE / TOUCH INPUT
--==================================================

local INPUT_LOCK_NAME = "C9HZZ_MainUI_InputLock"

local function sinkInput()
	return Enum.ContextActionResult.Sink
end

local function lockMainUI()
	ContextActionService:BindActionAtPriority(
		INPUT_LOCK_NAME,
		sinkInput,
		false,
		Enum.ContextActionPriority.High.Value,

		-- Mouse
		Enum.UserInputType.MouseButton1,
		Enum.UserInputType.MouseButton2,
		Enum.UserInputType.MouseButton3,

		-- Touch
		Enum.UserInputType.Touch
	)
end

local function unlockMainUI()
	ContextActionService:UnbindAction(INPUT_LOCK_NAME)
end

-- Lock immediately when the script starts.
lockMainUI()

--==================================================
-- STOP ALL AUDIO FIRST
--==================================================

if amb.IsPlaying then
	amb:Stop()
end

if level1.IsPlaying then
	level1:Stop()
end

if level2.IsPlaying then
	level2:Stop()
end

amb.Volume = 0

level1.Volume = 0
level1.Looped = true
level1.PlaybackSpeed = 1

level2.Volume = 0

--==================================================
-- SPEECH FUNCTION
--==================================================

local function say(text, duration)
	text = tostring(text)
	duration = duration or 3

	dialogueLabel.AutoLocalize = false
	dialogueLabel.Text = text

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = true
	end

	pcall(function()
		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},
			true, -- Space / B / Touch can skip dialogue
			duration,
			characterVoice
		)
	end)

	-- Make sure the voice stops after the dialogue ends.
	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	dialogueLabel.Text = ""

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = false
	end

	task.wait(0.15)
end

--==================================================
-- INTRO
--==================================================

task.wait(0.5)

say("Injecting the script.", 2)

say("Initializing.", 1.5)

say("Ambient audio is disabled.", 2)

--==================================================
-- LEVEL 1
--==================================================

say("Starting Level 1 audio.", 2)

-- Start Level 1 at normal speed and zero volume.
level1.Volume = 0
level1.PlaybackSpeed = 1
level1.Looped = true
level1:Play()

say("Slowing Level 1 audio down to zero point five.", 2)

-- Gradually slow from 1.0 to 0.5.
local speedTween = TweenService:Create(
	level1,
	TweenInfo.new(
		3,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out
	),
	{
		PlaybackSpeed = 0.5
	}
)

speedTween:Play()

-- Gradually bring the music in at the same time.
local volumeTween = TweenService:Create(
	level1,
	TweenInfo.new(
		2,
		Enum.EasingStyle.Linear
	),
	{
		Volume = 1
	}
)

volumeTween:Play()

speedTween.Completed:Wait()

say("Level 1 audio is now playing at zero point five speed.", 2)

--==================================================
-- LEVEL 2
--==================================================

say("Level 2 audio is disabled.", 2)

level2.Volume = 0
level2:Stop()

--==================================================
-- FINISH
--==================================================

say("Initialization complete.", 2)

say("This is a c9hzz mod.", 3)

task.wait(0.5)

--==================================================
-- RESTORE INPUT
--==================================================

unlockMainUI()
