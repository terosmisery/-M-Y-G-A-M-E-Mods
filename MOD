--==================================================
-- OBJECTS TO HIDE DURING DIALOGUE
--==================================================

local fadeObjects = {
	layer1Group:WaitForChild("GameButton1"),
	layer1Group:WaitForChild("GameButton2"),
	layer1Group:WaitForChild("GameButton3"),
	layer1Group:WaitForChild("Background"),
	celestialGroup:WaitForChild("Moon"),
	celestialGroup:WaitForChild("Sun")
}

--==================================================
-- SAVE ORIGINAL TRANSPARENCIES
--==================================================

local originalTransparency = {}

for _, obj in ipairs(fadeObjects) do
	local state = {}

	if obj:IsA("GuiObject") then
		state.BackgroundTransparency = obj.BackgroundTransparency
	end

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		state.ImageTransparency = obj.ImageTransparency
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		state.TextTransparency = obj.TextTransparency
	end

	originalTransparency[obj] = state
end

--==================================================
-- FORCE HIDDEN
--==================================================

local function forceHidden()
	for _, obj in ipairs(fadeObjects) do
		if obj:IsA("GuiObject") then
			obj.BackgroundTransparency = 1
		end

		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.ImageTransparency = 1
		end

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			obj.TextTransparency = 1
		end
	end
end

--==================================================
-- FADE OUT
--==================================================

local function fadeLayer1Out()
	local completed = 0
	local total = 0

	for _, obj in ipairs(fadeObjects) do
		if obj:IsA("GuiObject") then
			total += 1

			local properties = {
				BackgroundTransparency = 1
			}

			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				properties.ImageTransparency = 1
			end

			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				properties.TextTransparency = 1
			end

			local tween = TweenService:Create(
				obj,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				properties
			)

			tween.Completed:Connect(function()
				completed += 1
			end)

			tween:Play()
		end
	end

	task.wait(1.5)

	-- Make absolutely sure another script hasn't restored them.
	forceHidden()
end

--==================================================
-- FADE IN
--==================================================

local function fadeLayer1In()
	for _, obj in ipairs(fadeObjects) do
		if obj:IsA("GuiObject") then
			local original = originalTransparency[obj]

			if original then
				local properties = {}

				if original.BackgroundTransparency ~= nil then
					properties.BackgroundTransparency =
						original.BackgroundTransparency
				end

				if original.ImageTransparency ~= nil then
					properties.ImageTransparency =
						original.ImageTransparency
				end

				if original.TextTransparency ~= nil then
					properties.TextTransparency =
						original.TextTransparency
				end

				TweenService:Create(
					obj,
					TweenInfo.new(
						1.5,
						Enum.EasingStyle.Sine,
						Enum.EasingDirection.Out
					),
					properties
				):Play()
			end
		end
	end

	task.wait(1.5)
end

--==================================================
-- CONTINUOUS LOCKS
--==================================================

local interactionLocked = true

local lockedButtons = {}
local lockedTextBoxes = {}

local function enforceGuiLock()
	for _, obj in ipairs(mainUI:GetDescendants()) do
		if obj:IsA("GuiButton") then
			if not lockedButtons[obj] then
				lockedButtons[obj] = {
					Active = obj.Active,
					Selectable = obj.Selectable,
					AutoButtonColor = obj.AutoButtonColor
				}
			end

			obj.Active = false
			obj.Selectable = false
			obj.AutoButtonColor = false

		elseif obj:IsA("TextBox") then
			if not lockedTextBoxes[obj] then
				lockedTextBoxes[obj] = {
					Active = obj.Active,
					TextEditable = obj.TextEditable
				}
			end

			obj.Active = false
			obj.TextEditable = false
		end
	end
end

local function restoreGui()
	for obj, state in pairs(lockedButtons) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.Selectable = state.Selectable
			obj.AutoButtonColor = state.AutoButtonColor
		end
	end

	for obj, state in pairs(lockedTextBoxes) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.TextEditable = state.TextEditable
		end
	end

	table.clear(lockedButtons)
	table.clear(lockedTextBoxes)
end

--==================================================
-- ONE HEARTBEAT LOOP FOR BOTH LOCKS
--==================================================

enforceGuiLock()

local enforcementConnection = RunService.Heartbeat:Connect(function()
	if not interactionLocked then
		return
	end

	enforceGuiLock()
	forceHidden()
end)

