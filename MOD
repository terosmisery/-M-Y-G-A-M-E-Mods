local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "C9HZZ",
			Text = tostring(text),
			Duration = 3
		})
	end)
end

--==================================================
-- FIND UI
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local layer1Group = baseFrame:WaitForChild("Layer1Group")
local celestialGroup = layer1Group:WaitForChild("CelestialGroup")

local dialogueLabel =
	layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		:WaitForChild("Layer2Group")
		:WaitForChild("BaseGroup")
		:WaitForChild("GameFrame")
		:WaitForChild("DialogueFrame")

local requestSpeech = dialogueFrame:WaitForChild("RequestSpeech")
local characterVoice = mainUI:FindFirstChild("Character_Voice", true)

if not dialogueLabel then
	notify("DialogueLabel missing")
	return
end

if not characterVoice then
	notify("Character_Voice missing")
	return
end

--==================================================
-- FADE TARGETS
--==================================================

local fadeTargets = {
	layer1Group:WaitForChild("GameButton1"),
	layer1Group:WaitForChild("GameButton2"),
	layer1Group:WaitForChild("GameButton3"),
	layer1Group:WaitForChild("Background"),
	celestialGroup:WaitForChild("Moon"),
	celestialGroup:WaitForChild("Sun")
}

--==================================================
-- COLLECT ALL GUI OBJECTS
--==================================================

local fadeParts = {}

for _, root in ipairs(fadeTargets) do
	if root:IsA("GuiObject") then
		table.insert(fadeParts, root)
	end

	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("GuiObject") then
			table.insert(fadeParts, obj)
		end
	end
end

--==================================================
-- SAVE ORIGINAL TRANSPARENCIES
--==================================================

local original = {}

for _, obj in ipairs(fadeParts) do
	local data = {}

	if obj:IsA("GuiObject") then
		data.BackgroundTransparency = obj.BackgroundTransparency
	end

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		data.ImageTransparency = obj.ImageTransparency
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		data.TextTransparency = obj.TextTransparency
	end

	original[obj] = data
end

--==================================================
-- HIDE
--==================================================

local function hideImmediately()
	for _, obj in ipairs(fadeParts) do
		if obj.Parent == nil then
			continue
		end

		obj.BackgroundTransparency = 1

		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			obj.ImageTransparency = 1
		end

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			obj.TextTransparency = 1
		end
	end
end

local function fadeOut()
	for _, obj in ipairs(fadeParts) do
		if obj.Parent == nil then
			continue
		end

		local properties = {
			BackgroundTransparency = 1
		}

		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			properties.ImageTransparency = 1
		end

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			properties.TextTransparency = 1
		end

		TweenService:Create(
			obj,
			TweenInfo.new(
				1.5,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			),
			properties
		):Play()
	end

	task.wait(1.5)

	hideImmediately()
end

local function fadeIn()
	for _, obj in ipairs(fadeParts) do
		if obj.Parent == nil then
			continue
		end

		local data = original[obj]

		if not data then
			continue
		end

		TweenService:Create(
			obj,
			TweenInfo.new(
				1.5,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			),
			data
		):Play()
	end

	task.wait(1.5)
end

--==================================================
-- INPUT LOCK
--==================================================

local INPUT_NAME = "C9HZZ_Lock"

ContextActionService:BindActionAtPriority(
	INPUT_NAME,
	function()
		return Enum.ContextActionResult.Sink
	end,
	false,
	Enum.ContextActionPriority.High.Value,

	Enum.UserInputType.MouseButton1,
	Enum.UserInputType.MouseButton2,
	Enum.UserInputType.MouseButton3,
	Enum.UserInputType.Touch
)

--==================================================
-- DISABLE BUTTONS
--==================================================

local function disableButtons()
	for _, obj in ipairs(mainUI:GetDescendants()) do
		if obj:IsA("GuiButton") then
			obj.Active = false
			obj.Selectable = false
			obj.AutoButtonColor = false
		end
	end
end

disableButtons()

-- Keep them disabled because the game may re-enable them.
local lockConnection = RunService.Heartbeat:Connect(function()
	disableButtons()
end)

--==================================================
-- AUDIO
--==================================================

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

amb:Stop()
level1:Stop()
level2:Stop()

level1.Looped = true
level1.PlaybackSpeed = 1
level1.Volume = 0

level2.Volume = 0

--==================================================
-- SPEECH
--==================================================

local function say(text, duration)
	dialogueLabel.Text = text
	dialogueLabel.AutoLocalize = false
	dialogueLabel.Parent.Visible = true

	pcall(function()
		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},
			false,
			duration,
			characterVoice
		)
	end)

	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	dialogueLabel.Text = ""
	dialogueLabel.Parent.Visible = false

	task.wait(0.15)
end

--==================================================
-- START
--==================================================

task.wait(0.5)

notify("Fading Layer 1")

fadeOut()

notify("Layer 1 hidden")

say("Injecting the script.", 2)

say("Initializing.", 1.5)

say("Starting Level 1 audio.", 2)

level1:Play()

say("Slowing Level 1 audio down to zero point five.", 2)

TweenService:Create(
	level1,
	TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
	{
		PlaybackSpeed = 0.5
	}
):Play()

TweenService:Create(
	level1,
	TweenInfo.new(2),
	{
		Volume = 1
	}
):Play()

task.wait(3)

say("Level 1 audio is now playing at zero point five speed.", 2)

level2:Stop()
level2.Volume = 0

say("Initialization complete.", 2)

say("This is a c9hzz mod.", 3)

--==================================================
-- RESTORE
--==================================================

if lockConnection then
	lockConnection:Disconnect()
end

ContextActionService:UnbindAction(INPUT_NAME)

fadeIn()
