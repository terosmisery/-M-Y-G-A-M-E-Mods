local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

--==================================================
-- DIALOGUE SETUP
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local layer1Group =
	baseFrame:WaitForChild("Layer1Group")

local dialogueLabel =
	layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		:WaitForChild("Layer2Group")
		:WaitForChild("BaseGroup")
		:WaitForChild("GameFrame")
		:WaitForChild("DialogueFrame")

local requestSpeech =
	dialogueFrame:WaitForChild("RequestSpeech")

