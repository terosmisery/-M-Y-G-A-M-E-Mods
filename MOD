local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

--==================================================
-- DIALOGUE SETUP
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local layer1Group = baseFrame:WaitForChild("Layer1Group")

local dialogueLabel =
	layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		:WaitForChild("Layer2Group")
		:WaitForChild("BaseGroup")
		:WaitForChild("GameFrame")
		:WaitForChild("DialogueFrame")

local requestSpeech =
	dialogueFrame:WaitForChild("RequestSpeech")

local characterVoice =
	mainUI:FindFirstChild("Character_Voice", true)

if not dialogueLabel then
	return
end

if not characterVoice or not characterVoice:IsA("Sound") then
	return
end

--==================================================
-- INPUT LOCK
--==================================================

local interactionLocked = true

local lockedButtons = {}
local lockedTextBoxes = {}

local function enforceGuiLock()
	for _, obj in ipairs(mainUI:GetDescendants()) do
		if obj:IsA("GuiButton") then

			if not lockedButtons[obj] then
				lockedButtons[obj] = {
					Active = obj.Active,
					Selectable = obj.Selectable,
					AutoButtonColor = obj.AutoButtonColor
				}
			end

			obj.Active = false
			obj.Selectable = false
			obj.AutoButtonColor = false

		elseif obj:IsA("TextBox") then

			if not lockedTextBoxes[obj] then
				lockedTextBoxes[obj] = {
					Active = obj.Active,
					TextEditable = obj.TextEditable
				}
			end

			obj.Active = false
			obj.TextEditable = false
		end
	end
end

local function restoreGui()
	for obj, state in pairs(lockedButtons) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.Selectable = state.Selectable
			obj.AutoButtonColor = state.AutoButtonColor
		end
	end

	for obj, state in pairs(lockedTextBoxes) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.TextEditable = state.TextEditable
		end
	end

	table.clear(lockedButtons)
	table.clear(lockedTextBoxes)
end

enforceGuiLock()

local guiLockConnection = RunService.Heartbeat:Connect(function()
	if interactionLocked then
		enforceGuiLock()
	end
end)

--==================================================
-- INPUT BLOCK
--==================================================

local INPUT_LOCK_NAME = "C9HZZ_IntroInputLock"

ContextActionService:BindActionAtPriority(
	INPUT_LOCK_NAME,
	function()
		return Enum.ContextActionResult.Sink
	end,
	false,
	Enum.ContextActionPriority.High.Value,

	Enum.UserInputType.MouseButton1,
	Enum.UserInputType.MouseButton2,
	Enum.UserInputType.MouseButton3,
	Enum.UserInputType.Touch,

	Enum.UserInputType.Gamepad1,
	Enum.UserInputType.Gamepad2,
	Enum.UserInputType.Gamepad3,
	Enum.UserInputType.Gamepad4
)

--==================================================
-- AUDIO INITIAL STATE
--==================================================

amb:Stop()

level1:Stop()
level1.Looped = true
level1.Volume = 0
level1.PlaybackSpeed = 1

level2:Stop()
level2.Volume = 0

--==================================================
-- SPEECH
--==================================================

local function say(text, duration)

	text = tostring(text)
	duration = duration or 3

	dialogueLabel.AutoLocalize = false
	dialogueLabel.Text = text
	dialogueLabel.Parent.Visible = true

	pcall(function()
		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},
			false,
			duration,
			characterVoice
		)
	end)

	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	dialogueLabel.Text = ""
	dialogueLabel.Parent.Visible = false

	task.wait(0.15)
end

--==================================================
-- INTRO
--==================================================

task.wait(0.5)

say("Injecting the script.", 2)

say("Initializing.", 1.5)

--==================================================
-- LEVEL 1
--==================================================

say("Starting Level 1 audio.", 2)

level1.Volume = 0
level1.PlaybackSpeed = 1
level1.Looped = true
level1:Play()

say("Slowing Level 1 audio down to zero point five.", 2)

local speedTween = TweenService:Create(
	level1,
	TweenInfo.new(
		3,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out
	),
	{
		PlaybackSpeed = 0.5
	}
)

local volumeTween = TweenService:Create(
	level1,
	TweenInfo.new(
		2,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out
	),
	{
		Volume = 1
	}
)

speedTween:Play()
volumeTween:Play()

speedTween.Completed:Wait()

say("Level 1 audio is now playing at zero point five speed.", 2)

--==================================================
-- LEVEL 2
--==================================================

say("Level 2 audio is disabled.", 2)

level2:Stop()
level2.Volume = 0

--==================================================
-- FINAL DIALOGUE
--==================================================

say("Initialization complete.", 2)

say("This is a c9hzz mod.", 3)

--==================================================
-- ENJOY EFFECT OBJECTS
--==================================================

local head = layer1Group:WaitForChild("Head")
local eyeLabel = head:WaitForChild("EyeLabel")
local secretLabel = eyeLabel:WaitForChild("SecretLabel")

local vignetteLabel =
	baseFrame:WaitForChild("VignetteLabel")

local staticLabel =
	baseFrame:WaitForChild("StaticLabel")

--==================================================
-- COLLECT EFFECT GUI OBJECTS
--==================================================

local effectObjects = {}

local function addEffectObject(obj)
	if obj:IsA("GuiObject") then
		table.insert(effectObjects, obj)
	end
end

-- SecretLabel
addEffectObject(secretLabel)

-- VignetteLabel and its descendants
addEffectObject(vignetteLabel)

for _, obj in ipairs(vignetteLabel:GetDescendants()) do
	addEffectObject(obj)
end

-- StaticLabel and ALL of its descendants
addEffectObject(staticLabel)

for _, obj in ipairs(staticLabel:GetDescendants()) do
	addEffectObject(obj)
end

--==================================================
-- SAVE ORIGINAL STATE
--==================================================

local originalStates = {}

for _, obj in ipairs(effectObjects) do

	local state = {
		Visible = obj.Visible,
		BackgroundTransparency = obj.BackgroundTransparency
	}

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		state.ImageTransparency = obj.ImageTransparency
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		state.TextTransparency = obj.TextTransparency
	end

	originalStates[obj] = state
end

--==================================================
-- MAKE EFFECTS FULLY VISIBLE
--==================================================

local function prepareEffects()

	for _, obj in ipairs(effectObjects) do

		if obj and obj.Parent then

			obj.Visible = true

			-- Explicitly force backgrounds to 0.
			obj.BackgroundTransparency = 0

			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				obj.ImageTransparency = 0
			end

			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				obj.TextTransparency = 0
			end
		end
	end
end

--==================================================
-- FADE EFFECTS IN
--==================================================

local function fadeEffectsIn()

	for _, obj in ipairs(effectObjects) do

		if obj and obj.Parent then

			obj.Visible = true

			local properties = {
				BackgroundTransparency = 0
			}

			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				properties.ImageTransparency = 0
			end

			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				properties.TextTransparency = 0
			end

			TweenService:Create(
				obj,
				TweenInfo.new(
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				properties
			):Play()
		end
	end
end

--==================================================
-- FADE EFFECTS OUT TO ORIGINAL STATE
--==================================================

local function fadeEffectsOut()

	for _, obj in ipairs(effectObjects) do

		if obj and obj.Parent then

			local original = originalStates[obj]

			if original then

				local properties = {
					BackgroundTransparency =
						original.BackgroundTransparency
				}

				if original.ImageTransparency ~= nil then
					properties.ImageTransparency =
						original.ImageTransparency
				end

				if original.TextTransparency ~= nil then
					properties.TextTransparency =
						original.TextTransparency
				end

				TweenService:Create(
					obj,
					TweenInfo.new(
						1,
						Enum.EasingStyle.Sine,
						Enum.EasingDirection.In
					),
					properties
				):Play()
			end
		end
	end

	task.wait(1)
end

--==================================================
-- UISCALE ZOOM
--==================================================

local zoomScale = baseFrame:FindFirstChild("C9HZZEnjoyScale")

local createdScale = false

if not zoomScale then
	zoomScale = Instance.new("UIScale")
	zoomScale.Name = "C9HZZEnjoyScale"
	zoomScale.Scale = 1
	zoomScale.Parent = baseFrame
	createdScale = true
end

local originalScale = zoomScale.Scale

--==================================================
-- ENJOY
--==================================================

prepareEffects()

dialogueLabel.AutoLocalize = false
dialogueLabel.Text = "Enjoy."
dialogueLabel.Parent.Visible = true

-- Fade effects into full visibility.
fadeEffectsIn()

-- Slight zoom in.
local zoomIn = TweenService:Create(
	zoomScale,
	TweenInfo.new(
		1.2,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out
	),
	{
		Scale = originalScale * 1.05
	}
)

zoomIn:Play()

-- Keep Enjoy and the effects active for 5 seconds.
task.wait(5)

-- Fade effects back toward their original transparency.
fadeEffectsOut()

-- Zoom back to the original scale.
local zoomOut = TweenService:Create(
	zoomScale,
	TweenInfo.new(
		1.2,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut
	),
	{
		Scale = originalScale
	}
)

zoomOut:Play()
zoomOut.Completed:Wait()

--==================================================
-- RESTORE ORIGINAL EFFECT STATES
--==================================================

for obj, state in pairs(originalStates) do

	if obj and obj.Parent then

		obj.Visible = state.Visible
		obj.BackgroundTransparency =
			state.BackgroundTransparency

		if state.ImageTransparency ~= nil then
			obj.ImageTransparency =
				state.ImageTransparency
		end

		if state.TextTransparency ~= nil then
			obj.TextTransparency =
				state.TextTransparency
		end
	end
end

dialogueLabel.Text = ""
dialogueLabel.Parent.Visible = false

-- Remove the temporary UIScale if we created it.
if createdScale and zoomScale then
	zoomScale:Destroy()
else
	zoomScale.Scale = originalScale
end

--==================================================
-- UNLOCK
--==================================================

interactionLocked = false

if guiLockConnection then
	guiLockConnection:Disconnect()
end

ContextActionService:UnbindAction(INPUT_LOCK_NAME)

restoreGui()
