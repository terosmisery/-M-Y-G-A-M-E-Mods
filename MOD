local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

--==================================================
-- DIALOGUE SETUP
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local dialogueLabel =
	baseFrame.Layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		.Layer2Group
		.BaseGroup
		.GameFrame
		.DialogueFrame

local requestSpeech =
	dialogueFrame:WaitForChild("RequestSpeech")

local characterVoice =
	mainUI:FindFirstChild("Character_Voice", true)

if not dialogueLabel then
	warn("DialogueLabel not found")
	return
end

if not characterVoice or not characterVoice:IsA("Sound") then
	warn("Character_Voice not found")
	return
end

--==================================================
-- LOCK MAINUI INTERACTION
--==================================================

local locked = {}

local function lockMainUI()
	for _, obj in ipairs(mainUI:GetDescendants()) do
		if obj:IsA("GuiButton") then
			locked[obj] = {
				Active = obj.Active,
				Selectable = obj.Selectable,
				AutoButtonColor = obj.AutoButtonColor
			}

			obj.Active = false
			obj.Selectable = false
			obj.AutoButtonColor = false

		elseif obj:IsA("TextBox") then
			locked[obj] = {
				Active = obj.Active,
				TextEditable = obj.TextEditable
			}

			obj.Active = false
			obj.TextEditable = false
		end
	end
end

local function unlockMainUI()
	for obj, state in pairs(locked) do
		if obj and obj.Parent then
			if obj:IsA("GuiButton") then
				obj.Active = state.Active
				obj.Selectable = state.Selectable
				obj.AutoButtonColor = state.AutoButtonColor

			elseif obj:IsA("TextBox") then
				obj.Active = state.Active
				obj.TextEditable = state.TextEditable
			end
		end
	end

	table.clear(locked)
end

lockMainUI()

--==================================================
-- STOP AUDIO BEFORE NARRATION
--==================================================

if amb.IsPlaying then
	amb:Stop()
end

if level1.IsPlaying then
	level1:Stop()
end

if level2.IsPlaying then
	level2:Stop()
end

amb.Volume = 0
level1.Volume = 0
level2.Volume = 0

-- Slow Level 1 down
level1.PlaybackSpeed = 0.55
level1.Looped = true

--==================================================
-- SPEECH FUNCTION
--==================================================

local function say(text, duration)
	text = tostring(text)
	duration = duration or 3

	dialogueLabel.AutoLocalize = false
	dialogueLabel.Text = text

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = true
	end

	pcall(function()
		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},
			true,
			duration,
			characterVoice
		)
	end)

	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	dialogueLabel.Text = ""

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = false
	end

	task.wait(0.15)
end

--==================================================
-- INTRO
--==================================================

task.wait(0.5)

say("Injecting the script.", 2)

say("Initializing.", 1.5)

say("Ambient audio is disabled.", 2)

--==================================================
-- LEVEL 1
--==================================================

say("Starting Level 1 audio.", 2)

level1.Volume = 0
level1.PlaybackSpeed = 0.55
level1.Looped = true
level1:Play()

-- Smoothly fade Level 1 in
local fadeIn = TweenService:Create(
	level1,
	TweenInfo.new(2, Enum.EasingStyle.Linear),
	{Volume = 1}
)

fadeIn:Play()
fadeIn.Completed:Wait()

say("Level 1 audio is now playing.", 2)

--==================================================
-- LEVEL 2
--==================================================

say("Level 2 audio is disabled.", 2)

level2.Volume = 0
level2:Stop()

--==================================================
-- FINISH
--==================================================

say("Initialization complete.", 2)

say("This is a c9hzz mod.", 3)

-- Small final hold
task.wait(0.5)

--==================================================
-- RESTORE INTERACTION
--==================================================

unlockMainUI()
