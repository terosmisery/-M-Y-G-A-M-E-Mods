local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

--==================================================
-- DIALOGUE SETUP
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local dialogueLabel =
	baseFrame.Layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		.Layer2Group
		.BaseGroup
		.GameFrame
		.DialogueFrame

local requestSpeech =
	dialogueFrame:WaitForChild("RequestSpeech")

local characterVoice =
	mainUI:FindFirstChild("Character_Voice", true)

if not dialogueLabel then
	warn("DialogueLabel not found")
	return
end

if not characterVoice or not characterVoice:IsA("Sound") then
	warn("Character_Voice not found")
	return
end

--==================================================
-- BLOCK ALL INPUT EXCEPT SPACE
--==================================================

local INPUT_LOCK_NAME = "C9HZZ_IntroInputLock"

local function sinkInput()
	return Enum.ContextActionResult.Sink
end

local function lockInput()
	ContextActionService:BindActionAtPriority(
		INPUT_LOCK_NAME,
		sinkInput,
		false,
		Enum.ContextActionPriority.High.Value,

		-- Mouse
		Enum.UserInputType.MouseButton1,
		Enum.UserInputType.MouseButton2,
		Enum.UserInputType.MouseButton3,

		-- Touch
		Enum.UserInputType.Touch,

		-- Gamepad
		Enum.UserInputType.Gamepad1,
		Enum.UserInputType.Gamepad2,
		Enum.UserInputType.Gamepad3,
		Enum.UserInputType.Gamepad4,

		-- Keyboard keys EXCEPT Space
		Enum.KeyCode.E,
		Enum.KeyCode.F,
		Enum.KeyCode.Q,
		Enum.KeyCode.R,
		Enum.KeyCode.T,
		Enum.KeyCode.Y,
		Enum.KeyCode.U,
		Enum.KeyCode.I,
		Enum.KeyCode.O,
		Enum.KeyCode.P,
		Enum.KeyCode.A,
		Enum.KeyCode.S,
		Enum.KeyCode.D,
		Enum.KeyCode.G,
		Enum.KeyCode.H,
		Enum.KeyCode.J,
		Enum.KeyCode.K,
		Enum.KeyCode.L,
		Enum.KeyCode.Z,
		Enum.KeyCode.X,
		Enum.KeyCode.C,
		Enum.KeyCode.V,
		Enum.KeyCode.B,
		Enum.KeyCode.N,
		Enum.KeyCode.M,

		Enum.KeyCode.LeftShift,
		Enum.KeyCode.RightShift,
		Enum.KeyCode.LeftControl,
		Enum.KeyCode.RightControl,
		Enum.KeyCode.LeftAlt,
		Enum.KeyCode.RightAlt,
		Enum.KeyCode.Tab,
		Enum.KeyCode.Escape,
		Enum.KeyCode.Backspace,
		Enum.KeyCode.Delete,
		Enum.KeyCode.Insert,
		Enum.KeyCode.Home,
		Enum.KeyCode.End,
		Enum.KeyCode.PageUp,
		Enum.KeyCode.PageDown,

		Enum.KeyCode.Up,
		Enum.KeyCode.Down,
		Enum.KeyCode.Left,
		Enum.KeyCode.Right,

		Enum.KeyCode.One,
		Enum.KeyCode.Two,
		Enum.KeyCode.Three,
		Enum.KeyCode.Four,
		Enum.KeyCode.Five,
		Enum.KeyCode.Six,
		Enum.KeyCode.Seven,
		Enum.KeyCode.Eight,
		Enum.KeyCode.Nine,
		Enum.KeyCode.Zero
	)
end

local function unlockInput()
	ContextActionService:UnbindAction(INPUT_LOCK_NAME)
end

lockInput()

--==================================================
-- AUDIO INITIAL STATE
--==================================================

-- Amb is already disabled, so don't announce it.
if amb.IsPlaying then
	amb:Stop()
end

amb.Volume = 0

if level1.IsPlaying then
	level1:Stop()
end

if level2.IsPlaying then
	level2:Stop()
end

level1.Volume = 0
level1.Looped = true
level1.PlaybackSpeed = 1

level2.Volume = 0

--==================================================
-- SPEECH FUNCTION
--==================================================

local function say(text, duration)
	text = tostring(text)
	duration = duration or 3

	dialogueLabel.AutoLocalize = false
	dialogueLabel.Text = text

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = true
	end

	pcall(function()
		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},
			false, -- only Space should be used for skipping
			duration,
			characterVoice
		)
	end)

	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	dialogueLabel.Text = ""

	if dialogueLabel.Parent then
		dialogueLabel.Parent.Visible = false
	end

	task.wait(0.15)
end

--==================================================
-- INTRO
--==================================================

task.wait(0.5)

say("Injecting the script.", 2)

say("Initializing.", 1.5)

--==================================================
-- LEVEL 1
--==================================================

say("Starting Level 1 audio.", 2)

level1.Volume = 0
level1.PlaybackSpeed = 1
level1.Looped = true
level1:Play()

say("Slowing Level 1 audio down to zero point five.", 2)

local speedTween = TweenService:Create(
	level1,
	TweenInfo.new(
		3,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out
	),
	{
		PlaybackSpeed = 0.5
	}
)

local volumeTween = TweenService:Create(
	level1,
	TweenInfo.new(
		2,
		Enum.EasingStyle.Linear
	),
	{
		Volume = 1
	}
)

speedTween:Play()
volumeTween:Play()

speedTween.Completed:Wait()

say("Level 1 audio is now playing at zero point five speed.", 2)

--==================================================
-- LEVEL 2
--==================================================

say("Level 2 audio is disabled.", 2)

level2.Volume = 0
level2:Stop()

--==================================================
-- FINISH
--==================================================

say("Initialization complete.", 2)

say("This is a c9hzz mod.", 3)

task.wait(0.5)

--==================================================
-- RESTORE INPUT
--==================================================

unlockInput()
