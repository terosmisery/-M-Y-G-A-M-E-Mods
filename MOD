local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local mainUI = pg:WaitForChild("MainUI")

local amb = mainUI:WaitForChild("Amb")
local level1 = mainUI:WaitForChild("Level1")
local level2 = mainUI:WaitForChild("Level2")

--==================================================
-- DIALOGUE SETUP
--==================================================

local baseFrame =
	mainUI
		:WaitForChild("SurfaceScreen")
		:WaitForChild("BaseHolder")
		:WaitForChild("BaseFrame")

local dialogueLabel =
	baseFrame.Layer1Group:FindFirstChild("DialogueLabel", true)

local dialogueFrame =
	baseFrame
		.Layer2Group
		.BaseGroup
		.GameFrame
		.DialogueFrame

local requestSpeech =
	dialogueFrame:WaitForChild("RequestSpeech")

local characterVoice =
	mainUI:FindFirstChild("Character_Voice", true)

if not dialogueLabel then
	warn("DialogueLabel not found")
	return
end

if not characterVoice or not characterVoice:IsA("Sound") then
	warn("Character_Voice not found")
	return
end

--==================================================
-- CONTINUOUS GUI LOCK
--==================================================

local interactionLocked = true

local lockedButtons = {}
local lockedTextBoxes = {}

local function enforceGuiLock()
	for _, obj in ipairs(mainUI:GetDescendants()) do
		if obj:IsA("GuiButton") then
			if not lockedButtons[obj] then
				lockedButtons[obj] = {
					Active = obj.Active,
					Selectable = obj.Selectable,
					AutoButtonColor = obj.AutoButtonColor
				}
			end

			obj.Active = false
			obj.Selectable = false
			obj.AutoButtonColor = false

		elseif obj:IsA("TextBox") then
			if not lockedTextBoxes[obj] then
				lockedTextBoxes[obj] = {
					Active = obj.Active,
					TextEditable = obj.TextEditable
				}
			end

			obj.Active = false
			obj.TextEditable = false
		end
	end
end

local function restoreGui()
	for obj, state in pairs(lockedButtons) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.Selectable = state.Selectable
			obj.AutoButtonColor = state.AutoButtonColor
		end
	end

	for obj, state in pairs(lockedTextBoxes) do
		if obj and obj.Parent then
			obj.Active = state.Active
			obj.TextEditable = state.TextEditable
		end
	end

	table.clear(lockedButtons)
	table.clear(lockedTextBoxes)
end

-- Continuously enforce the lock.
enforceGuiLock()

local guiLockConnection = RunService.Heartbeat:Connect(function()
	if interactionLocked then
		enforceGuiLock()
	end
end)

