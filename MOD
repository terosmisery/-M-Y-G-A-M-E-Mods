--==================================================
-- COLLECT EFFECT OBJECTS
--==================================================

local effectObjects = {}

local function addEffect(obj)

	if obj:IsA("GuiObject") then
		table.insert(effectObjects, obj)
	end
end

addEffect(secretLabel)

addEffect(vignetteLabel)

for _, obj in ipairs(vignetteLabel:GetDescendants()) do
	addEffect(obj)
end

addEffect(staticLabel)

for _, obj in ipairs(staticLabel:GetDescendants()) do
	addEffect(obj)
end

--==================================================
-- SAVE ORIGINAL STATES
--==================================================

local originalStates = {}

for _, obj in ipairs(effectObjects) do

	local state = {
		Visible = obj.Visible,
		BackgroundTransparency = obj.BackgroundTransparency
	}

	if obj:IsA("ImageLabel")
		or obj:IsA("ImageButton") then

		state.ImageTransparency =
			obj.ImageTransparency
	end

	if obj:IsA("TextLabel")
		or obj:IsA("TextButton") then

		state.TextTransparency =
			obj.TextTransparency
	end

	originalStates[obj] = state
end

--==================================================
-- FORCE EFFECT BACKGROUNDS TO 1
--==================================================

local function forceEffectBackgrounds()

	for _, obj in ipairs(effectObjects) do

		if obj and obj.Parent then
			obj.BackgroundTransparency = 1
		end
	end
end

--==================================================
-- PREPARE EFFECTS
--==================================================

local function prepareEffects()

	for _, obj in ipairs(effectObjects) do

		if not obj or not obj.Parent then
			continue
		end

		obj.Visible = true

		-- Every effect background stays transparent.
		obj.BackgroundTransparency = 1

		if obj:IsA("ImageLabel")
			or obj:IsA("ImageButton") then

			obj.ImageTransparency = 1
		end

		if obj:IsA("TextLabel")
			or obj:IsA("TextButton") then

			obj.TextTransparency = 1
		end
	end

	forceEffectBackgrounds()
end

--==================================================
-- FADE EFFECTS IN
--==================================================

local function fadeEffectsIn()

	for _, obj in ipairs(effectObjects) do

		if not obj or not obj.Parent then
			continue
		end

		obj.Visible = true

		local properties = {}

		-- Background transparency is intentionally
		-- NOT included. It stays at 1.

		if obj:IsA("ImageLabel")
			or obj:IsA("ImageButton") then

			properties.ImageTransparency = 0
		end

		if obj:IsA("TextLabel")
			or obj:IsA("TextButton") then

			properties.TextTransparency = 0
		end

		if next(properties) then

			TweenService:Create(
				obj,

				TweenInfo.new(
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),

				properties

			):Play()
		end
	end

	forceEffectBackgrounds()
end

--==================================================
-- FADE EFFECTS OUT
--==================================================

local function fadeEffectsOut()

	for _, obj in ipairs(effectObjects) do

		if not obj or not obj.Parent then
			continue
		end

		local original =
			originalStates[obj]

		if not original then
			continue
		end

		local properties = {}

		-- All effect backgrounds remain 1.
		properties.BackgroundTransparency = 1

		if original.ImageTransparency ~= nil then

			properties.ImageTransparency =
				original.ImageTransparency
		end

		if original.TextTransparency ~= nil then

			properties.TextTransparency =
				original.TextTransparency
		end

		TweenService:Create(
			obj,

			TweenInfo.new(
				1,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.In
			),

			properties

		):Play()
	end

	task.wait(1)

	forceEffectBackgrounds()
end

--==================================================
-- UISCALE ZOOM
--==================================================

local zoomScale =
	baseFrame:FindFirstChild("C9HZZEnjoyScale")

local createdScale = false

if not zoomScale then

	zoomScale = Instance.new("UIScale")
	zoomScale.Name = "C9HZZEnjoyScale"
	zoomScale.Scale = 1
	zoomScale.Parent = baseFrame

	createdScale = true
end

local originalScale =
	zoomScale.Scale

--==================================================
-- EFFECT ENFORCEMENT
--==================================================

local effectLockConnection

effectLockConnection =
	RunService.Heartbeat:Connect(function()

		if not interactionLocked then
			return
		end

		if dialogueLabel.Text == "Enjoy." then
			forceEffectBackgrounds()
		end

	end)

--==================================================
-- ENJOY
--==================================================

prepareEffects()

dialogueLabel.AutoLocalize = false
dialogueLabel.Text = "Enjoy."
dialogueLabel.Parent.Visible = true

-- Voice + mouth animation.
-- PlaybackSpeed = 0.4.
characterVoice.PlaybackSpeed = 0.4

pcall(function()

	requestSpeech:Invoke(
		{
			{
				"Enjoy.",
				{
					IgnoreLocalize = true
				}
			}
		},

		false,
		5,
		characterVoice
	)

end)

-- Make sure the voice doesn't remain at 0.4 afterward.
if characterVoice.IsPlaying then
	characterVoice:Stop()
end

characterVoice.PlaybackSpeed = 1

--==================================================
-- EFFECT / ZOOM TIMING
--==================================================

-- Re-display the line because RequestSpeech may
-- modify the dialogue UI itself.
dialogueLabel.Text = "Enjoy."
dialogueLabel.Parent.Visible = true

fadeEffectsIn()

local zoomIn =
	TweenService:Create(

		zoomScale,

		TweenInfo.new(
			1.2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out
		),

		{
			Scale = originalScale * 1.05
		}
	)

zoomIn:Play()

task.wait(5)

fadeEffectsOut()

local zoomOut =
	TweenService:Create(

		zoomScale,

		TweenInfo.new(
			1.2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut
		),

		{
			Scale = originalScale
		}
	)

zoomOut:Play()
zoomOut.Completed:Wait()

--==================================================
-- RESTORE EFFECTS
--==================================================

for obj, state in pairs(originalStates) do

	if obj and obj.Parent then

		obj.Visible = state.Visible

		-- Effect backgrounds stay transparent.
		obj.BackgroundTransparency = 1

		if state.ImageTransparency ~= nil then

			obj.ImageTransparency =
				state.ImageTransparency
		end

		if state.TextTransparency ~= nil then

			obj.TextTransparency =
				state.TextTransparency
		end
	end
end

dialogueLabel.Text = ""
dialogueLabel.Parent.Visible = false

--==================================================
-- CLEANUP
--==================================================

if createdScale and zoomScale then
	zoomScale:Destroy()
else
	zoomScale.Scale = originalScale
end

if effectLockConnection then
	effectLockConnection:Disconnect()
end

interactionLocked = false

if guiLockConnection then
	guiLockConnection:Disconnect()
end

ContextActionService:UnbindAction(
	INPUT_LOCK_NAME
)

restoreGui()
