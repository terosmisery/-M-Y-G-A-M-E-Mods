--==================================================
-- SPEECH
--==================================================

local function say(text, duration, playbackSpeed)

	text = tostring(text)
	duration = duration or 3

	local oldPlaybackSpeed =
		characterVoice.PlaybackSpeed

	-- Allow individual dialogue lines to use
	-- a different voice speed.
	if playbackSpeed then
		characterVoice.PlaybackSpeed = playbackSpeed
	end

	dialogueLabel.AutoLocalize = false
	dialogueLabel.Text = text
	dialogueLabel.Parent.Visible = true

	pcall(function()

		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},

			false,
			duration,
			characterVoice
		)

	end)

	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	characterVoice.PlaybackSpeed =
		oldPlaybackSpeed

	dialogueLabel.Text = ""
	dialogueLabel.Parent.Visible = false

	task.wait(0.15)
end

--==================================================
-- INTRO
--==================================================

task.wait(0.5)

say("Injecting the script.", 2)

say("Initializing.", 1.5)

--==================================================
